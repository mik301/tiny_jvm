# Install parameter handling, end to end.
#   INS 10 -> the C9 application parameters the applet received
#   INS 20 -> the instance AID it was installed under
#   INS 30 -> the privileges byte
#   INS 40 -> the lengths of the AID and the parameters
#
# Run with:  ./run.sh params.jcvm

genparams params.cap
load params.cap

# --- 1. plain C9, short length ---------------------------------------------
install A0000050524101 A000005052410101 A1B2C3D4

send 00 A4 04 00 08 A000005052410101
send 80 10 00 00 00      # expect A1 B2 C3 D4
send 80 20 00 00 00      # expect A0 00 00 50 52 41 01 01
send 80 30 00 00 00      # expect 00
send 80 40 00 00 00      # expect 08 04

# --- 2. C9 plus an EF system block with toolkit parameters ------------------
# EF contains CA: priority 1, 2 timers, 16 char menu, 2 entries (pos/id pairs)
install A0000050524101 A000005052410102 0102030405 EF0CCA0A0102100201010202 00

send 00 A4 04 00 08 A000005052410102
send 80 10 00 00 00      # expect 01 02 03 04 05  (only the C9 part reaches it)
send 80 40 00 00 00      # expect 08 05

# The EF block never reaches the applet; the card manager consumed it.
params C9 05 0102030405 EF 0C CA 0A 01 02 10 02 01 01 02 02 00

# --- 3. a C9 longer than 127 bytes, so the field uses the 81 length form ----
# 0x90 = 144 bytes of application parameters
install A0000050524101 A000005052410103 000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F202122232425262728292A2B2C2D2E2F303132333435363738393A3B3C3D3E3F404142434445464748494A4B4C4D4E4F505152535455565758595A5B5C5D5E5F606162636465666768696A6B6C6D6E6F707172737475767778797A7B7C7D7E7F808182838485868788898A8B8C8D8E8F

send 00 A4 04 00 08 A000005052410103
send 80 40 00 00 00      # expect 08 90   <- 144 bytes arrived intact

gp
quit
